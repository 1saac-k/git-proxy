## git-proxy-users: users who can login to git-proxy UI (alice + bob)
dn: cn=git-proxy-users,ou=groups,dc=gitproxy,dc=local
objectClass: groupOfNames
objectClass: group
cn: git-proxy-users
description: Users allowed to login to git-proxy
objectCategory: CN=Group,CN=Schema,CN=Configuration,DC=gitproxy,DC=local
member: cn=alice,ou=people,dc=gitproxy,dc=local
member: cn=bob,ou=people,dc=gitproxy,dc=local

## git-proxy-admins: users with admin rights in git-proxy (alice only)
dn: cn=git-proxy-admins,ou=groups,dc=gitproxy,dc=local
objectClass: groupOfNames
objectClass: group
cn: git-proxy-admins
description: Administrators of git-proxy
objectCategory: CN=Group,CN=Schema,CN=Configuration,DC=gitproxy,DC=local
member: cn=alice,ou=people,dc=gitproxy,dc=local
